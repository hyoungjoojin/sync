# Copy to terraform.tfvars (gitignored) and fill in real values.
# Secrets here end up in Terraform state — treat this file, and the state
# backend, accordingly (state bucket should be private + encrypted).

postgres_password = "changeme"

google_client_id     = "changeme"
google_client_secret = "changeme"

# Gmail SMTP: mail_username is the sending Gmail address, mail_password is a
# 16-character App Password (Google Account > Security > App passwords —
# requires 2-Step Verification), not the account login password.
mail_username = "changeme"
mail_password = "changeme"

slack_webhook_url = ""

better_auth_secret = "changeme"
